{
  "name": "@apteva/telephony-source",
  "private": true,
  "scripts": {
    "build:frontend": "bun run frontend/build-app.ts",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "test:frontend": "bun test frontend/tests/*.test.ts && bun test ui/*.test.ts",
    "example": "bun frontend/example/server.ts",
    "test:example": "bunx --no-install playwright test -c frontend/example/playwright.config.ts",
    "benchmark:softphone": "bun benchmarks/softphone/run.ts",
    "benchmark:internal-audio": "bun benchmarks/internal-audio/run.ts",
    "typecheck:benchmark": "tsc -p benchmarks/softphone/tsconfig.json --noEmit && tsc -p benchmarks/outbound-sip/tsconfig.json --noEmit",
    "benchmark:outbound-sip": "bun benchmarks/outbound-sip/run.ts",
    "benchmark:agent-audio": "bun benchmarks/agent-audio/run.ts",
    "test:agent-playout": "env GOWORK=off go test -run \"^TestAgent(Playout|AudioTrace|SIPRecovery)\" -count=1 -v .",
    "test:network": "bun test frontend/tests/network-resilience.test.ts frontend/tests/rtc-send-policy.test.ts frontend/tests/client.test.ts frontend/tests/rtc-ice.test.ts && env GOWORK=off go test -run \"^TestNetwork\" -count=1 .",
    "test:network:browser": "env GOWORK=off go test -tags integration -run \"^Test(NetworkCheckBrowserNoMicrophoneOrCall|NetworkCheckBrowserDetectsRealDatagramLoss|NetworkBrowserDirectVersusRelayRealPacketLoss|TURNBrowserMediaCredentialRenewal)$\" -count=1 -timeout 5m -v .",
    "test:network:speech": "env GOWORK=off go test -run \"^TestNetworkSpeechReplay$\" -count=1 -v .",
    "test:call-inspector": "bun test ui/call-diagnostics.test.ts && bunx --no-install playwright test -c frontend/call-inspector.playwright.config.ts",
    "test:call-statistics": "bun test ui/call-statistics.test.ts && bunx --no-install playwright test -c frontend/call-statistics.playwright.config.ts",
    "test:auto-answer": "bun test frontend/tests/auto-answer.test.ts && env GOWORK=off go test -run \"^TestAutoAnswer\" -count=1 .",
    "test:auto-answer:browser": "env GOWORK=off go test -tags integration -run \"^TestAutoAnswerRealBrowserPickup$\" -count=1 -timeout 90s -v .",
    "test:managed-media": "env GOWORK=off go test -tags integration -run \"^TestManagedRuntimeAutomaticBrowserAnswerAndRenewal$\" -count=1 -timeout 2m -v ."
  },
  "devDependencies": {
    "@apteva/web-sdk": "0.7.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/react": "19",
    "@types/react-dom": "19",
    "react": "19",
    "react-dom": "19",
    "typescript": "^7.0.2"
  }
}
