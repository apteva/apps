  },
  "devDependencies": {
    "@apteva/web-sdk": "0.7.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/react": "19",
    "@types/react-dom": "19",
    "react": "19",
    "react-dom": "19",
    "typescript": "^7.0.2"
  }
}
