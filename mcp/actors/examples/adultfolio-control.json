{
  "operations": {
    "get_search_options": {
      "read_only": true,
      "steps": [
        {
          "action": "goto",
          "url": "https://www.adultfolio.com/search",
          "locator": {}
        },
        {
          "action": "wait",
          "locator": {},
          "duration_ms": 2000
        },
        {
          "action": "extract",
          "locator": {},
          "items": "body",
          "fields": {
            "account_url": {
              "selector": ".navbar a:containsown(\"Your Profile\")",
              "type": "url",
              "attribute": "href",
              "required": true
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 1
        },
        {
          "action": "assert_values",
          "locator": {},
          "assertions": {
            "account_url": {
              "equals_url": {
                "url": "{{account_url}}"
              }
            }
          }
        },
        {
          "action": "extract",
          "locator": {},
          "items": "#search_members select[name=\"profile\"],#search_members select[name=\"distance\"],#search_members select[name=\"order\"],#search_members select[name=\"gender\"],#search_members select[name=\"country\"]",
          "fields": {
            "filter_id": {
              "type": "text",
              "attribute": "id"
            },
            "filter_name": {
              "type": "text",
              "attribute": "name"
            },
            "option_labels": {
              "many": true,
              "selector": "option",
              "type": "text"
            },
            "option_values": {
              "many": true,
              "selector": "option",
              "type": "text",
              "attribute": "value"
            },
            "selected_value": {
              "selector": "option[selected]",
              "type": "text",
              "attribute": "value"
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 10
        }
      ],
      "output_schema": null
    },
    "get_thread": {
      "read_only": true,
      "steps": [
        {
          "action": "goto",
          "url": "https://www.adultfolio.com/message.php?user={{model_id}}",
          "locator": {}
        },
        {
          "action": "wait",
          "locator": {},
          "duration_ms": 2000
        },
        {
          "action": "extract",
          "locator": {},
          "items": "body",
          "fields": {
            "account_url": {
              "selector": ".navbar a:containsown(\"Your Profile\")",
              "type": "url",
              "attribute": "href",
              "required": true
            },
            "recipient_url": {
              "selector": ".MainTitle a.a4",
              "type": "url",
              "attribute": "href",
              "required": true
            },
            "thread_class": {
              "selector": "#MessageResult",
              "type": "text",
              "attribute": "class",
              "required": true
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 1
        },
        {
          "action": "assert_values",
          "locator": {},
          "assertions": {
            "account_url": {
              "equals_url": {
                "url": "{{account_url}}"
              }
            },
            "recipient_url": {
              "equals_url": {
                "url": "{{model_url}}"
              }
            },
            "thread_class": {
              "equals_exact": "conversation-{{model_id}}"
            }
          }
        },
        {
          "read_views": {
            "entry_url": "https://www.adultfolio.com/message.php?user={{model_id}}",
            "identity_url": "{{account_url}}",
            "identity": {
              "selector": ".navbar a:containsown(\"Your Profile\")",
              "type": "url",
              "attribute": "href",
              "required": true
            },
            "views": [
              {
                "use_entry_page": true,
                "name": "messages",
                "covers": [
                  "messages"
                ],
                "link_selector": "",
                "url_pattern": "^https://www\\.adultfolio\\.com/message\\.php\\?user={{model_id}}(?:&|$)",
                "ready_selector": "#MessageResult[class=\"conversation-{{model_id}}\"]",
                "empty_text_pattern": "(?i)no messages",
                "empty_selector": "#MessageResult",
                "loading_selector": ".loading-overlay[aria-busy=\"true\"],#messaging_btf[aria-busy=\"true\"],#MessageResult[aria-busy=\"true\"],#oldMessage:contains(\"Loading\"),#oldMessage:contains(\"loading\")",
                "items": "#MessageResult .messageContainer.message-modern-wrap",
                "fields": {
                  "attachment_url": {
                    "selector": ".message-modern-body a[href]",
                    "type": "url",
                    "attribute": "href"
                  },
                  "attachment_urls": {
                    "many": true,
                    "selector": ".message-modern-body a[href]",
                    "type": "url",
                    "attribute": "href"
                  },
                  "body": {
                    "selector": ".message-modern-body",
                    "type": "text",
                    "preserve_line_breaks": true,
                    "pattern": "(?s)^\\s*(.*?)\\s*$"
                  },
                  "image_url": {
                    "selector": ".message-modern-body img[src]",
                    "type": "url",
                    "attribute": "src"
                  },
                  "image_urls": {
                    "many": true,
                    "selector": ".message-modern-body img[src]",
                    "type": "url",
                    "attribute": "src"
                  },
                  "message_id": {
                    "type": "text",
                    "attribute": "id",
                    "required": true,
                    "pattern": "^([0-9]+)$"
                  },
                  "read_at": {
                    "selector": ".message-modern-meta .timeago:nth-of-type(2)",
                    "type": "text",
                    "attribute": "title"
                  },
                  "sender_url": {
                    "selector": "a.thumbnailPic",
                    "type": "url",
                    "attribute": "href",
                    "required": true
                  },
                  "sent_at": {
                    "selector": ".message-modern-meta .timeago",
                    "type": "text",
                    "attribute": "title",
                    "required": true
                  }
                },
                "field_defaults": {
                  "direction": "incoming",
                  "record_type": "message",
                  "model_id": "{{model_id}}",
                  "model_url": "{{model_url}}"
                },
                "field_rewrites": {
                  "direction": {
                    "from": "sender_url",
                    "pattern": ".*",
                    "replacement": "outgoing",
                    "when_field": "sender_url",
                    "equals": "{{account_url}}"
                  }
                },
                "key_field": "message_id",
                "pagination": {
                  "end_when_next_absent": true,
                  "mode": "next",
                  "next": {
                    "text": "Load Older Messages",
                    "selector": "#oldMessage:not([style*=\"display: none\"]):not([style*=\"display:none\"])",
                    "exact": true,
                    "som_only": true
                  },
                  "max_pages": "{{read_pages}}",
                  "stable_rounds": 2,
                  "settle_ms": 5000,
                  "on_stall": "partial",
                  "advance_timeout_ms": 20000,
                  "reveal_from": "start"
                }
              }
            ],
            "timeout_ms": 10000,
            "allow_partial": true
          },
          "action": "inspect_views",
          "locator": {}
        }
      ],
      "output_schema": null
    },
