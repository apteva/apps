{
  "operations": {
    "create_tier_preflight": {
      "steps": [
        {
          "action": "goto",
          "url": "{{new_tier_url}}",
          "locator": {}
        },
        {
          "action": "wait",
          "locator": {},
          "duration_ms": 3500
        },
        {
          "text": "{{tier_name}}",
          "action": "fill",
          "locator": {
            "selector": "#tier-title-name"
          }
        },
        {
          "text": "{{tier_description}}",
          "action": "fill",
          "locator": {
            "selector": "[role=\"textbox\"]"
          }
        },
        {
          "text": "{{monthly_price}}",
          "action": "fill",
          "locator": {
            "selector": "input[name=\"product-price\"]"
          }
        },
        {
          "action": "set_checked",
          "locator": {
            "selector": "button[role=\"switch\"]"
          },
          "checked": "{{free_trial}}"
        },
        {
          "action": "extract",
          "locator": {},
          "items": "body",
          "fields": {
            "free_trial": {
              "selector": "button[role=\"switch\"]",
              "type": "boolean",
              "attribute": "aria-checked",
              "required": true,
              "pattern": "^\\Q{{free_trial}}\\E$"
            },
            "monthly_price": {
              "selector": "input[name=\"product-price\"]",
              "type": "number",
              "attribute": "value",
              "required": true,
              "pattern": "^\\Q{{monthly_price}}\\E$"
            },
            "tier_description": {
              "selector": "[role=\"textbox\"]",
              "type": "text",
              "required": true,
              "pattern": "^\\Q{{tier_description}}\\E$"
            },
            "tier_name": {
              "selector": "#tier-title-name",
              "type": "text",
              "attribute": "value",
              "required": true,
              "pattern": "^\\Q{{tier_name}}\\E$"
            }
          },
          "readability": false
        },
        {
          "direction": "down",
          "amount": 900,
          "action": "scroll",
          "locator": {}
        },
        {
          "action": "click",
          "locator": {
            "text": "Cancel",
            "role": "button",
            "exact": true,
            "som_only": true
          }
        },
        {
          "action": "wait",
          "locator": {},
          "duration_ms": 1500
        },
        {
          "action": "click",
          "locator": {
            "text": "Leave",
            "role": "button",
            "exact": true,
            "som_only": true
          }
        },
        {
          "action": "wait_for",
          "locator": {},
          "conditions": [
            {
              "type": "text_present",
              "value": "Paid membership tiers"
            }
          ],
          "match": "all",
          "timeout_ms": 15000
        }
      ],
      "output_schema": {}
    },
