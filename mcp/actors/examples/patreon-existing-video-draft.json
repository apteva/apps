                  },
                  "title": {
                    "selector": "a[href*=\"/posts/\"]",
                    "type": "text",
                    "required": true
                  },
                  "edit_url": {
                    "selector": "a[href*=\"/posts/\"]",
                    "type": "url",
                    "attribute": "href",
                    "required": true
                  },
                  "row_text": {
                    "type": "text"
                  }
                },
                "field_defaults": {
                  "status": "draft"
                },
                "field_rewrites": {},
                "key_field": "id",
                "total": {
                  "selector": "body",
                  "type": "number",
                  "required": true,
                  "pattern": "\\d+ - \\d+ of (\\d+)\\s*$"
                },
                "pagination": {
                  "mode": "scroll",
                  "next": {
                    "text": "Go To Next Page",
                    "role": "button",
                    "exact": true,
                    "som_only": true
                  },
                  "scroll_target_name": "Document",
                  "amount": 5000,
                  "max_pages": 100,
                  "stable_rounds": 3,
                  "settle_ms": 1500
                }
              }
            ],
            "timeout_ms": 30000
          },
          "read_only": true
        },
        {
          "action": "select_record",
          "verified_field": "id",
          "value": "{{post_id}}"
        },
        {
          "action": "assert_values",
          "assertions": {
            "id": {
              "equals": "{{post_id}}"
            },
            "status": {
              "equals": "draft"
            },
            "edit_url": {
              "equals": "{{post_edit_url}}"
            }
          }
        },
        {
          "action": "goto",
          "url": "{{post_edit_url}}"
        },
        {
          "action": "wait_for",
          "conditions": [
            {
              "type": "text_present",
              "value": "Saved"
            },
            {
              "type": "selector_present",
              "selector": "textarea[aria-label=\"Title\"]"
            }
          ],
          "match": "all",
          "timeout_ms": 30000
        },
        {
          "action": "observe_page",
          "items": "body",
          "fields": {
            "saved_title": {
              "selector": "textarea[aria-label=\"Title\"]",
              "type": "text",
              "required": true
            },
            "saved_body": {
              "selector": "[aria-label=\"Text input field for post content\"] p",
              "type": "text",
              "required": false,
              "all": true,
              "separator": "\n\n",
              "preserve_line_breaks": true
            },
            "draft_publish_control": {
              "selector": "[data-tag=\"make-a-post-action-publish\"]",
              "type": "text",
              "required": true,
              "pattern": "^Publish$"
            }
          },
          "readability": false
        },
        {
          "action": "assert_values",
          "assertions": {
            "current_url": {
              "equals": "{{post_edit_url}}"
            }
          }
        },
        {
          "action": "assert_values",
          "assertions": {
            "saved_title": {
              "equals": "{{post_title}}"
            },
            "saved_body": {
              "equals": "{{post_body}}"
            }
          }
        },
        {
          "action": "assert_element",
          "locator": {
            "selector": "body:not(:has([data-tag=\"post-iframe-wrapper\"])):not(:has([data-tag=\"image-layout\"])):not(:has(button[aria-label=\"Menu for additional actions on the uploaded media\"]))"
          }
        },
        {
          "action": "set_checked",
          "locator": {
            "selector": "input[type=\"radio\"][value=\"paid\"]"
          },
          "checked": true
        },
        {
          "action": "set_checked",
          "locator": {
            "selector": "#sell-post-toggle"
          },
          "checked": false
        },
        {
          "action": "assert_element",
          "locator": {
            "selector": "#sell-post-toggle[aria-checked=\"false\"]"
          }
        },
        {
          "action": "click",
          "locator": {
            "text": "Select tiers",
            "exact": true,
            "som_only": true
          }
        },
        {
          "action": "set_checked",
          "locator": {
            "text": "Select all tiers",
            "exact": true,
            "som_only": true,
            "role": "menuitemcheckbox"
          },
          "checked": true
        },
        {
          "action": "set_checked",
          "locator": {
            "text": "Select all tiers",
            "exact": true,
            "som_only": true,
            "role": "menuitemcheckbox"
          },
          "checked": false
        },
        {
          "action": "set_checked",
          "locator": {
            "role": "menuitemcheckbox",
            "exact": true,
            "som_only": true,
            "text_suffix_pattern": "(?:\\s+[0-9]+\\s+members?)?"
          },
          "labels": "{{tier_labels}}",
          "checked": true
        },
        {
          "action": "extract",
          "items": "body",
          "fields": {
            "sale_off_before_audience": {
              "selector": "#sell-post-toggle",
              "type": "text",
              "required": true,
              "attribute": "aria-checked",
              "pattern": "^false$"
            },
            "sell_post": {
              "selector": "#sell-post-toggle",
              "type": "boolean",
              "required": true,
              "attribute": "aria-checked",
              "pattern": "^false$"
            },
            "sell_this_post": {
              "selector": "#sell-post-toggle",
              "type": "boolean",
              "required": true,
              "attribute": "aria-checked",
              "pattern": "^false$"
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 1
        },
        {
          "action": "key",
          "key": "ESC"
        },
        {
          "action": "set_checked",
          "locator": {
            "selector": "input[type=\"radio\"][value=\"{{audience}}\"]"
          },
          "checked": true
        },
        {
          "action": "click",
          "locator": {
            "text": "Video",
            "exact": true,
            "som_only": true,
            "role": "button"
          }
        },
        {
          "action": "wait",
          "duration_ms": 700
        },
        {
          "action": "click",
          "locator": {
            "text": "embed URL,",
            "exact": true,
            "som_only": true,
            "role": "button"
          }
        },
        {
          "action": "wait",
          "duration_ms": 700
        },
        {
          "action": "set_text",
          "locator": {
            "text": "Type or paste URL",
            "exact": true,
            "som_only": true
          },
          "text": "{{video_url}}",
          "mode": "replace"
        },
        {
          "action": "wait_for",
          "conditions": [
            {
              "type": "media_present"
            },
            {
              "type": "text_present",
              "value": "Saved"
            }
          ],
          "match": "all",
          "timeout_ms": 30000
        },
        {
          "action": "key",
          "key": "CTRL+R"
        },
        {
          "action": "wait",
          "duration_ms": 2000
        },
        {
          "action": "wait_for",
          "conditions": [
            {
              "type": "media_present"
            },
            {
              "type": "text_present",
              "value": "Saved"
            }
          ],
          "match": "all",
          "timeout_ms": 30000
        },
        {
          "action": "extract",
          "items": "[data-tag=\"post-iframe-wrapper\"]",
          "fields": {
            "media_block": {
              "selector": "",
              "type": "text",
              "required": true,
              "attribute": "data-tag"
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 1
        },
        {
          "action": "observe_page",
          "items": "body",
          "readability": false,
          "fields": {
            "saved_title": {
              "selector": "textarea[aria-label=\"Title\"]",
              "type": "text",
              "required": true
            },
            "saved_body": {
              "selector": "[aria-label=\"Text input field for post content\"] p",
              "type": "text",
              "required": false,
              "all": true,
              "separator": "\n\n",
              "preserve_line_breaks": true
            },
            "draft_publish_control": {
              "selector": "[data-tag=\"make-a-post-action-publish\"]",
              "type": "text",
              "required": true,
              "pattern": "^Publish$"
            },
            "audience": {
              "selector": "input[type=\"radio\"][value=\"{{audience}}\"][aria-checked=\"true\"]",
              "type": "text",
              "required": true,
              "attribute": "value",
              "pattern": "^\\Q{{audience}}\\E$"
            },
            "sale_off": {
              "selector": "#sell-post-toggle[aria-checked=\"false\"],body:not(:has(#sell-post-toggle[aria-checked=\"true\"])) input[value=\"public\"][aria-checked=\"true\"]",
              "type": "text",
              "required": true,
              "attribute": "aria-checked",
              "pattern": "^(false|true)$"
            },
            "sell_post": {
              "selector": "#sell-post-toggle",
              "type": "boolean",
              "attribute": "aria-checked",
              "pattern": "^false$"
            },
            "sell_this_post": {
              "selector": "#sell-post-toggle",
              "type": "boolean",
              "attribute": "aria-checked",
              "pattern": "^false$"
            },
            "exactly_one_embed": {
              "selector": "[data-tag=\"post-iframe-wrapper\"]",
              "type": "text",
              "required": true,
              "attribute": "data-tag",
              "pattern": "^post-iframe-wrapper$"
            }
          }
        },
        {
          "action": "assert_values",
          "assertions": {
            "current_url": {
              "equals": "{{post_edit_url}}"
            },
            "saved_title": {
              "equals": "{{post_title}}"
            },
            "saved_body": {
              "equals": "{{post_body}}"
            },
            "media_iframe_src": {
              "matches": "^\\Q{{video_url}}\\E(?:\\?.*)?$"
            },
            "media_embed_status": {
              "equals": "loaded"
            },
            "media_error_text": {
              "equals": ""
            },
            "draft_save_state": {
              "equals": "saved"
            }
          }
        },
        {
          "action": "click",
          "locator": {
            "text": "Select tiers",
            "exact": true,
            "som_only": true
          },
          "optional": true
        },
        {
          "action": "extract",
          "items": "body",
          "fields": {
            "saved_tiers": {
              "selector": "[role=\"menuitemcheckbox\"][aria-checked=\"true\"]:not(:contains(\"Select all tiers\")),input[value=\"public\"][aria-checked=\"true\"]",
              "type": "text",
              "required": false,
              "all": true,
              "separator": "\n"
            },
            "audience_with_valid_tiers": {
              "selector": "input[value=\"public\"][aria-checked=\"true\"],body:has([role=\"menuitemcheckbox\"][aria-checked=\"true\"]:not(:contains(\"Select all tiers\"))) input[value=\"paid\"][aria-checked=\"true\"]",
              "type": "text",
              "required": true,
              "attribute": "value",
              "pattern": "^\\Q{{audience}}\\E$"
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 1
        },
        {
          "action": "assert_values",
          "assertions": {
            "saved_tiers": {
              "equals_set": "{{tier_labels}}"
            }
          }
        },
        {
          "action": "key",
          "key": "ESC"
        }
      ],
      "output_schema": {}
    },
