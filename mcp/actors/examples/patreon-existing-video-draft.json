        {
          "action": "observe_page",
          "items": "body",
          "readability": false,
          "fields": {
            "saved_title": {
              "selector": "textarea[aria-label=\"Title\"]",
              "type": "text",
              "required": true
            },
            "saved_body": {
              "selector": "[aria-label=\"Text input field for post content\"] p",
              "type": "text",
              "required": false,
              "all": true,
              "separator": "\n\n",
              "preserve_line_breaks": true
            },
            "draft_publish_control": {
              "selector": "[data-tag=\"make-a-post-action-publish\"]",
              "type": "text",
              "required": true,
              "pattern": "^Publish$"
            },
            "audience": {
              "selector": "input[type=\"radio\"][value=\"{{audience}}\"][aria-checked=\"true\"]",
              "type": "text",
              "required": true,
              "attribute": "value",
              "pattern": "^\\Q{{audience}}\\E$"
            },
            "sale_off": {
              "selector": "#sell-post-toggle[aria-checked=\"false\"],body:not(:has(#sell-post-toggle[aria-checked=\"true\"])) input[value=\"public\"][aria-checked=\"true\"]",
              "type": "text",
              "required": true,
              "attribute": "aria-checked",
              "pattern": "^(false|true)$"
            },
            "sell_post": {
              "selector": "#sell-post-toggle",
              "type": "boolean",
              "attribute": "aria-checked",
              "pattern": "^false$"
            },
            "sell_this_post": {
              "selector": "#sell-post-toggle",
              "type": "boolean",
              "attribute": "aria-checked",
              "pattern": "^false$"
            },
            "exactly_one_embed": {
              "selector": "[data-tag=\"post-iframe-wrapper\"]",
              "type": "text",
              "required": true,
              "attribute": "data-tag",
              "pattern": "^post-iframe-wrapper$"
            }
          }
        },
        {
          "action": "assert_values",
          "assertions": {
            "current_url": {
              "equals": "{{post_edit_url}}"
            },
            "saved_title": {
              "equals": "{{post_title}}"
            },
            "saved_body": {
              "equals": "{{post_body}}"
            },
            "media_iframe_src": {
              "matches": "^\\Q{{video_url}}\\E(?:\\?.*)?$"
            },
            "media_embed_status": {
              "equals": "loaded"
            },
            "media_error_text": {
              "equals": ""
            },
            "draft_save_state": {
              "equals": "saved"
            }
          }
        },
        {
          "action": "click",
          "locator": {
            "text": "Select tiers",
            "exact": true,
            "som_only": true
          },
          "optional": true
        },
        {
          "action": "extract",
          "items": "body",
          "fields": {
            "saved_tiers": {
              "selector": "[role=\"menuitemcheckbox\"][aria-checked=\"true\"]:not(:contains(\"Select all tiers\")),input[value=\"public\"][aria-checked=\"true\"]",
              "type": "text",
              "required": false,
              "all": true,
              "separator": "\n"
            },
            "audience_with_valid_tiers": {
              "selector": "input[value=\"public\"][aria-checked=\"true\"],body:has([role=\"menuitemcheckbox\"][aria-checked=\"true\"]:not(:contains(\"Select all tiers\"))) input[value=\"paid\"][aria-checked=\"true\"]",
              "type": "text",
              "required": true,
              "attribute": "value",
              "pattern": "^\\Q{{audience}}\\E$"
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 1
        },
        {
          "action": "assert_values",
          "assertions": {
            "saved_tiers": {
              "equals_set": "{{tier_labels}}"
            }
          }
        },
        {
          "action": "key",
          "key": "ESC"
        },
        {
          "action": "click",
          "locator": {
            "text": "Publish",
            "role": "button",
            "exact": true,
            "som_only": true
          },
          "expected_text": "Publish",
          "expected_effect": "immediate_external_commit",
          "confirm_consequence": "immediate_external_commit",
          "once_key": "draft-video:{{post_id}}:{{request_id}}"
        },
        {
          "action": "wait_for",
          "locator": {},
          "conditions": [
            {
              "type": "text_present",
              "value": "Your post is live and ready to share!"
            },
            {
              "type": "url_contains",
              "value": "/posts/"
            }
          ],
          "match": "all",
          "timeout_ms": 30000
        },
        {
          "action": "observe_page",
          "items": "body",
          "readability": false,
          "fields": {
            "published_confirmation": {
              "selector": "",
              "type": "text",
              "required": true,
              "pattern": "Your post is live and ready to share!"
            }
          }
        },
        {
          "action": "assert_values",
          "assertions": {
            "current_url": {
              "matches": "^https://www\\.patreon\\.com/[^?#]*/posts/(?:[^/?]*-)?\\Q{{post_id}}\\E(?:[?#].*)?$"
            }
          }
        }
      ],
      "output_schema": {}
    }
  }
}