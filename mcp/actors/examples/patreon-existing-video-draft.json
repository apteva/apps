{
  "schema_version": 1,
  "browser": {
    "context_id": "{{context_id}}",
    "persist": true
  },
  "allowed_hosts": [
    "www.patreon.com",
    "patreon.com"
  ],
  "defaults": {
    "library_url": "https://www.patreon.com/library"
  },
  "limits": {
    "max_pages": 200,
    "max_items": 5000,
    "max_duration_seconds": 1200,
    "step_retries": 0
  },
  "operations": {
    "inspect_video_draft": {
      "read_only": true,
      "limits": {
        "max_pages": 200,
        "max_items": 5000,
        "max_duration_seconds": 1200,
        "step_retries": 0
      },
      "steps": [
        {
          "action": "inspect_views",
          "read_views": {
            "entry_url": "{{library_url}}",
            "identity_url": "{{creator_url}}",
            "identity": {
              "selector": "a[aria-label=\"Your page\"]",
              "type": "url",
              "attribute": "href",
              "required": true,
              "pattern": "^https://www\\.patreon\\.com/(?:(?:c|cw)/)?([^/?]+)(?:[/?]|$)"
            },
            "views": [
              {
                "name": "drafts",
                "covers": [
                  "draft"
                ],
                "link_selector": "a[class*=\"subNavLink\"][href=\"https://www.patreon.com/posts/drafts\"]",
                "url_pattern": "^https://www\\.patreon\\.com/posts/drafts/?$",
                "ready_selector": "[class*=\"Table-module\"][class*=\"__headerRow\"]",
                "empty_selector": "main:contains(\"No drafts\"),main:contains(\"You don\u2019t have any drafts\"),[class*=\"EmptyState\"]",
                "loading_selector": "[class*=\"Table-module\"][class*=\"__row\"][class*=\"__clickable\"]:not(:has(a[href*=\"/posts/\"])),[class*=\"Skeleton\"],[aria-busy=\"true\"]",
                "error_selector": "main [role=\"alert\"],[role=\"dialog\"]",
                "items": "[class*=\"Table-module\"][class*=\"__row\"][class*=\"__clickable\"]:has(a[href*=\"/posts/\"])",
                "fields": {
                  "id": {
                    "selector": "a[href*=\"/posts/\"]",
                    "attribute": "href",
                    "required": true,
                    "pattern": "/posts/(?:[^/?]*-)?(\\d+)(?:/edit)?(?:\\?|$)"
                  },
                  "title": {
                    "selector": "a[href*=\"/posts/\"]",
                    "type": "text",
                    "required": true
                  },
                  "edit_url": {
                    "selector": "a[href*=\"/posts/\"]",
                    "type": "url",
                    "attribute": "href",
                    "required": true
                  },
                  "row_text": {
                    "type": "text"
                  }
                },
                "field_defaults": {
                  "status": "draft"
                },
                "field_rewrites": {},
                "key_field": "id",
                "total": {
                  "selector": "body",
                  "type": "number",
                  "required": true,
                  "pattern": "\\d+ - \\d+ of (\\d+)\\s*$"
                },
                "pagination": {
                  "mode": "scroll",
                  "next": {
                    "text": "Go To Next Page",
                    "role": "button",
                    "exact": true,
                    "som_only": true
                  },
                  "scroll_target_name": "Document",
                  "amount": 5000,
                  "max_pages": 100,
                  "stable_rounds": 3,
                  "settle_ms": 1500
                }
              }
            ],
            "timeout_ms": 30000
          },
          "read_only": true
        },
        {
          "action": "select_record",
          "verified_field": "id",
          "value": "{{post_id}}"
        },
        {
          "action": "assert_values",
          "assertions": {
            "id": {
              "equals": "{{post_id}}"
            },
            "status": {
              "equals": "draft"
            },
            "edit_url": {
              "equals": "{{post_edit_url}}"
            }
          }
        },
        {
          "action": "goto",
          "url": "{{post_edit_url}}"
        },
        {
          "action": "wait_for",
          "conditions": [
            {
              "type": "text_present",
              "value": "Saved"
            },
            {
              "type": "selector_present",
              "selector": "textarea[aria-label=\"Title\"]"
            }
          ],
          "match": "all",
          "timeout_ms": 30000
        },
        {
          "action": "observe_page",
          "items": "body",
          "fields": {
            "saved_title": {
              "selector": "textarea[aria-label=\"Title\"]",
              "type": "text",
              "required": true
            },
            "saved_body": {
              "selector": "[aria-label=\"Text input field for post content\"] p",
              "type": "text",
              "required": false,
              "all": true,
              "separator": "\n\n",
              "preserve_line_breaks": true
            },
            "draft_publish_control": {
              "selector": "[data-tag=\"make-a-post-action-publish\"]",
              "type": "text",
              "required": true,
              "pattern": "^Publish$"
            }
          },
          "readability": false
        },
        {
          "action": "assert_values",
          "assertions": {
            "current_url": {
              "equals": "{{post_edit_url}}"
            }
          }
        }
      ],
      "output_schema": {}
    },
    "attach_video_to_draft": {
      "limits": {
        "max_pages": 200,
