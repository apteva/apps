        "step_retries": 0
      },
      "read_only": true,
      "steps": [
        {
          "read_views": {
            "entry_url": "{{library_url}}",
            "identity_url": "{{creator_url}}",
            "identity": {
              "selector": "a[aria-label=\"Your page\"]",
              "type": "url",
              "attribute": "href",
