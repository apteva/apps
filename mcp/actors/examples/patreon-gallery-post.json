{
  "schema_version": 1,
  "browser": {
    "context_id": "{{context_id}}",
    "persist": true
  },
  "allowed_hosts": [
    "patreon.com",
    "www.patreon.com"
  ],
  "limits": {
    "max_duration_seconds": 300,
    "step_retries": 0
  },
  "defaults": {},
  "operations": {
    "gallery_post": {
      "steps": [
        {
          "action": "goto",
          "url": "{{creator_url}}",
          "locator": {}
        },
        {
          "action": "wait",
          "locator": {},
          "duration_ms": 4000
        },
        {
          "action": "click",
          "locator": {
            "text": "Create",
            "role": "button",
            "exact": true,
            "som_only": true
          }
        },
        {
          "action": "wait",
          "locator": {},
          "duration_ms": 700
        },
        {
          "action": "click",
          "locator": {
            "text": "Post",
            "role": "menuitem",
            "exact": true,
            "som_only": true
          },
          "expected_text": "Post"
        },
        {
          "action": "wait",
          "locator": {},
          "duration_ms": 2500
        },
        {
          "text": "{{post_title}}",
          "action": "fill",
          "locator": {
            "text": "Title",
            "exact": true,
            "som_only": true
          }
        },
        {
          "text": "{{post_body}}",
          "action": "set_text",
          "locator": {
            "text": "Text input field for post content",
            "role": "textbox",
            "exact": true,
            "som_only": true
          },
          "mode": "replace",
          "newline_mode": "preserve"
        },
        {
          "action": "set_checked",
          "locator": {
            "selector": "input[type=\"radio\"][value=\"paid\"]"
          },
          "checked": true
        },
        {
          "action": "set_checked",
          "locator": {
            "selector": "#sell-post-toggle"
          },
          "checked": false
        },
        {
          "action": "assert_element",
          "locator": {
            "selector": "#sell-post-toggle[aria-checked=\"false\"]"
          }
        },
        {
          "action": "click",
          "locator": {
            "text": "Select tiers",
            "exact": true,
            "som_only": true
          }
        },
        {
          "action": "set_checked",
          "locator": {
            "text": "Select all tiers",
            "exact": true,
            "som_only": true,
            "role": "menuitemcheckbox"
          },
          "checked": true
        },
        {
          "action": "set_checked",
          "locator": {
            "text": "Select all tiers",
            "exact": true,
            "som_only": true,
            "role": "menuitemcheckbox"
          },
          "checked": false
        },
        {
          "action": "set_checked",
          "locator": {
            "role": "menuitemcheckbox",
            "exact": true,
            "som_only": true
          },
          "labels": "{{tier_labels}}",
          "checked": true
        },
        {
          "action": "extract",
          "items": "body",
          "fields": {
            "sale_off_before_audience": {
              "selector": "#sell-post-toggle",
              "type": "text",
              "required": true,
              "attribute": "aria-checked",
              "pattern": "^false$"
            },
            "sell_post": {
              "selector": "#sell-post-toggle",
              "type": "boolean",
              "required": true,
              "attribute": "aria-checked",
              "pattern": "^false$"
            },
            "sell_this_post": {
              "selector": "#sell-post-toggle",
              "type": "boolean",
              "required": true,
              "attribute": "aria-checked",
              "pattern": "^false$"
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 1
        },
        {
          "action": "key",
          "key": "ESC"
        },
        {
          "action": "set_checked",
          "locator": {
            "selector": "input[type=\"radio\"][value=\"{{audience}}\"]"
          },
          "checked": true
        },
        {
          "action": "click",
          "locator": {
            "text": "Image",
            "exact": true,
            "som_only": true
          }
        },
        {
          "action": "wait",
          "duration_ms": 700
        },
        {
          "action": "upload_file",
          "locator": {
            "text": "Browse",
            "exact": true,
            "som_only": true
          },
          "source_url": "{{image_1_source_url}}",
          "filename": "{{image_1_filename}}",
          "mime_type": "{{image_1_mime_type}}"
        },
        {
          "action": "key",
          "key": "ESC"
        },
        {
          "action": "wait_for",
          "conditions": [
            {
              "type": "text_present",
              "value": "Saved"
            },
            {
              "type": "selector_present",
              "selector": "img[src*=\"/patreon-media/p/post/\"]"
            }
          ],
          "match": "all",
          "timeout_ms": 30000
        },
        {
          "action": "extract",
          "items": "body",
          "fields": {
            "uploaded_first_id": {
              "selector": "img[src*=\"/patreon-media/p/post/\"]",
              "type": "text",
              "required": true,
              "attribute": "src",
              "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 1
        },
        {
          "action": "upload_file",
          "locator": {
            "text": "Add image",
            "exact": true,
            "som_only": true
          },
          "source_url": "{{image_2_source_url}}",
          "filename": "{{image_2_filename}}",
          "mime_type": "{{image_2_mime_type}}"
        },
        {
          "action": "wait_for",
          "conditions": [
            {
              "type": "text_present",
              "value": "Saved"
            },
            {
              "type": "selector_present",
              "selector": "[data-tag=\"image-layout\"] > [class*=\"__imageWrapper\"]:nth-child(2) img"
            }
          ],
          "match": "all",
          "timeout_ms": 30000
        },
        {
          "action": "extract",
          "items": "body",
          "fields": {
            "uploaded_second_id": {
              "selector": "[data-tag=\"image-layout\"] > [class*=\"__imageWrapper\"]:nth-child(2) img",
              "type": "text",
              "required": true,
              "attribute": "src",
              "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
            },
            "first_after_second_id": {
              "selector": "img[src*=\"/patreon-media/p/post/\"]",
              "type": "text",
              "required": true,
              "attribute": "src",
              "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 1
        },
        {
          "action": "assert_values",
          "assertions": {
            "first_after_second_id": {
              "equals_field": "uploaded_first_id"
            }
          }
        },
        {
          "action": "key",
          "key": "CTRL+R"
        },
        {
          "action": "wait",
          "duration_ms": 2500
        },
        {
          "action": "wait_for",
          "conditions": [
            {
              "type": "text_present",
              "value": "Saved"
            },
            {
              "type": "selector_present",
              "selector": "[data-tag=\"image-layout\"] > [class*=\"__imageWrapper\"]:nth-child(2) img"
            }
          ],
          "match": "all",
          "timeout_ms": 30000
        },
        {
          "action": "extract",
          "items": "body:has(input[value=\"paid\"][aria-checked=\"true\"]) [data-tag=\"image-layout\"] img[class*=\"__blurred\"],body:has(input[value=\"public\"][aria-checked=\"true\"]) [data-tag=\"image-layout\"] img:not([class*=\"__blurred\"])",
          "fields": {
            "attachment_id": {
              "selector": "",
              "type": "text",
              "required": true,
              "attribute": "src",
              "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
            }
          },
          "readability": false,
          "min_items": 2,
          "max_items": 2
        },
        {
          "action": "extract",
          "items": "body",
          "fields": {
            "gallery_exactly_two": {
              "selector": "[data-tag=\"image-layout\"]:has([class*=\"__imageWrapper\"]:nth-child(2)):not(:has([class*=\"__imageWrapper\"]:nth-child(3)))",
              "type": "text",
              "required": true,
              "attribute": "data-tag",
              "pattern": "^image-layout$"
            },
            "saved_first_id": {
              "selector": "[data-tag=\"image-layout\"] > [class*=\"__imageWrapper\"]:nth-child(1) img",
              "type": "text",
              "required": true,
              "attribute": "src",
              "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
            },
            "saved_second_id": {
              "selector": "[data-tag=\"image-layout\"] > [class*=\"__imageWrapper\"]:nth-child(2) img",
              "type": "text",
              "required": true,
              "attribute": "src",
              "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
            },
            "saved_title": {
              "selector": "textarea[aria-label=\"Title\"]",
              "type": "text",
              "required": true,
              "pattern": "^\\Q{{post_title}}\\E$"
            },
            "saved_body": {
              "selector": "[aria-label=\"Text input field for post content\"] p",
              "type": "text",
              "required": true,
              "pattern": "^\\Q{{post_body}}\\E$",
              "all": true,
              "preserve_line_breaks": true,
              "separator": "\n\n"
            },
            "audience": {
              "selector": "input[type=\"radio\"][value=\"{{audience}}\"][aria-checked=\"true\"]",
              "type": "text",
              "required": true,
              "attribute": "value",
              "pattern": "^\\Q{{audience}}\\E$"
            },
            "sale_off_evidence": {
              "selector": "#sell-post-toggle[aria-checked=\"false\"],body:not(:has(#sell-post-toggle[aria-checked=\"true\"])) input[value=\"public\"][aria-checked=\"true\"]",
              "type": "text",
              "required": true,
              "attribute": "aria-checked",
              "pattern": "^(false|true)$"
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 1
        },
        {
          "action": "assert_values",
          "assertions": {
            "saved_first_id": {
              "equals_field": "uploaded_first_id"
            },
            "saved_second_id": {
              "equals_field": "uploaded_second_id"
            }
          }
        },
        {
          "action": "click",
          "locator": {
            "text": "Select tiers",
            "exact": true,
            "som_only": true
          },
          "optional": true
        },
        {
          "action": "extract",
          "items": "body",
          "fields": {
            "saved_tiers": {
              "selector": "[role=\"menuitemcheckbox\"][aria-checked=\"true\"]:not(:contains(\"Select all tiers\")),input[value=\"public\"][aria-checked=\"true\"]",
              "type": "text",
              "required": false,
              "all": true,
              "separator": "\n"
            },
            "audience_with_valid_tiers": {
              "selector": "input[value=\"public\"][aria-checked=\"true\"],body:has([role=\"menuitemcheckbox\"][aria-checked=\"true\"]:not(:contains(\"Select all tiers\"))) input[value=\"paid\"][aria-checked=\"true\"]",
              "type": "text",
              "required": true,
              "attribute": "value",
              "pattern": "^\\Q{{audience}}\\E$"
            }
          },
          "readability": false,
          "min_items": 1,
          "max_items": 1
        },
        {
          "action": "assert_values",
          "assertions": {
            "saved_tiers": {
              "equals_set": "{{tier_labels}}"
            }
          }
        },
        {
          "action": "key",
          "key": "ESC"
        },
        {
          "action": "click",
          "locator": {
            "text": "Publish",
            "role": "button",
            "exact": true,
            "som_only": true
          },
          "expected_text": "Publish",
          "expected_effect": "immediate_external_commit",
          "confirm_consequence": "immediate_external_commit",
          "once_key": "{{request_id}}"
        },
        {
          "action": "wait_for",
          "locator": {},
          "conditions": [
            {
              "type": "text_present",
              "value": "Your post is live and ready to share!"
            },
            {
              "type": "url_contains",
              "value": "/posts/"
            }
          ],
          "match": "all",
          "timeout_ms": 30000
        },
        {
          "action": "extract",
          "locator": {},
          "items": "body",
          "fields": {
            "published_confirmation": {
              "type": "text",
              "required": true,
              "pattern": "Your post is live and ready to share!"
            }
          },
          "readability": false
        }
      ],
      "output_schema": {}
    },
    "list_tiers": {
      "steps": [
        {
          "action": "goto",
          "url": "{{tiers_url}}",
          "locator": {}
        },
        {
          "action": "wait",
          "locator": {},
          "duration_ms": 3500
        },
        {
          "action": "wait_for",
          "locator": {},
          "conditions": [
            {
              "type": "text_present",
              "value": "Paid membership tiers"
            }
          ],
          "match": "all",
          "timeout_ms": 15000
        },
        {
          "action": "extract",
          "locator": {},
          "items": "body",
          "fields": {
            "creator_heading": {
              "selector": "h1",
              "type": "text"
            },
            "creator_name": {
              "selector": "input[name=\"name\"]",
              "type": "text",
              "attribute": "value"
            },
            "page_text": {
              "type": "text",
              "required": true
            }
          },
          "readability": false
        },
        {
          "action": "extract",
          "items": "div[class*=\"Card-module\"][class*=\"__root\"]:has(a[href*=\"/membership/\"])",
          "readability": false,
          "max_items": 50,
          "fields": {
            "tier_id": {
              "selector": "a[href*=\"/membership/\"]",
              "attribute": "href",
              "type": "text",
              "required": true,
              "pattern": "/membership/([0-9]+)"
            },
            "edit_url": {
              "selector": "a[href*=\"/membership/\"]",
              "attribute": "href",
              "type": "url",
              "required": true
            },
            "tier_name": {
              "selector": "[class*=\"TierCardHeader\"][class*=\"__styledHeader\"]",
              "type": "text",
              "pattern": "^(.*?)\\s*(?:Unpublished\\s+)?(?:US\\$|\\$|\u20ac|\u00a3|USD|EUR|GBP)\\s*[0-9]+(?:[.,][0-9]+)?\\s*/\\s*month"
            },
            "price_display": {
              "selector": "[class*=\"TierCardHeader\"][class*=\"__styledHeader\"]",
              "type": "text",
              "required": true,
              "pattern": "(?:US\\$|\\$|\u20ac|\u00a3|USD|EUR|GBP)\\s*[0-9]+(?:[.,][0-9]+)?\\s*/\\s*month"
            },
            "monthly_price": {
              "selector": "[class*=\"TierCardHeader\"][class*=\"__styledHeader\"]",
              "type": "number",
              "pattern": "(?:US\\$|\\$|\u20ac|\u00a3|USD|EUR|GBP)\\s*([0-9]+(?:\\.[0-9]+)?)\\s*/\\s*month"
            },
            "currency_symbol": {
              "selector": "[class*=\"TierCardHeader\"][class*=\"__styledHeader\"]",
              "type": "text",
              "required": true,
              "pattern": "(US\\$|\\$|\u20ac|\u00a3|USD|EUR|GBP)\\s*[0-9]"
            },
            "member_count": {
              "selector": "[class*=\"TierCardHeader\"][class*=\"__styledHeader\"]",
              "type": "integer",
              "pattern": "([0-9]+)\\s+members?"
            },
            "status_label": {
              "selector": "[class*=\"TierCardHeader\"][class*=\"__styledHeader\"]",
              "type": "text",
              "pattern": "(Unpublished)"
            },
            "plan_text": {
              "type": "text",
              "required": true
            }
          }
        }
      ],
      "output_schema": {}
    },
    "get_tier": {
      "steps": [
        {
          "action": "goto",
          "url": "{{tier_edit_url}}",
          "locator": {}
        },
        {
          "action": "wait",
          "locator": {},
          "duration_ms": 3500
        },
        {
          "action": "extract",
          "locator": {},
          "items": "body",
          "fields": {
            "free_trial": {
              "selector": "button[role=\"switch\"]",
              "type": "boolean",
              "attribute": "aria-checked",
              "required": true
            },
            "monthly_price": {
              "selector": "input[name=\"product-price\"]",
              "type": "number",
              "attribute": "value",
              "required": true
            },
            "tier_description": {
              "selector": "[role=\"textbox\"]",
              "type": "text"
            },
            "tier_name": {
              "selector": "#tier-title-name",
              "type": "text",
              "attribute": "value"
            }
          },
          "readability": false
        }
      ],
      "output_schema": {}
    }
  },
  "steps": [],
  "output_schema": {}
}
