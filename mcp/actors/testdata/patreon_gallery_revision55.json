{
  "recovery": {
    "inspection_operation": "fetch_posts",
    "required_views": [
      "published",
      "scheduled",
      "draft"
    ],
    "match_fields": {
      "title": "post_title"
    }
  },
  "steps": [
    {
      "action": "goto",
      "url": "{{creator_url}}",
      "locator": {}
    },
    {
      "action": "wait_for",
      "locator": {},
      "conditions": [
        {
          "type": "selector_present",
          "selector": "nav[aria-label=\"Creator navigation\"] button[aria-label=\"Create post\"]"
        }
      ],
      "match": "all",
      "timeout_ms": 30000
    },
    {
      "action": "extract",
      "locator": {},
      "items": "body",
      "fields": {
        "creator_identity": {
          "selector": "a[aria-label=\"Your page\"]",
          "type": "text",
          "attribute": "href",
          "required": true,
          "pattern": "^https://www\\.patreon\\.com/(?:(?:c|cw)/)?([^/?]+)(?:[/?]|$)"
        },
        "creator_url": {
          "selector": "a[aria-label=\"Your page\"]",
          "type": "url",
          "attribute": "href",
          "required": true
        }
      },
      "readability": false,
      "min_items": 1,
      "max_items": 1
    },
    {
      "action": "assert_values",
      "locator": {},
      "assertions": {
        "creator_identity": {
          "equals_exact": "{{expected_creator_identity}}"
        }
      }
    },
    {
      "action": "click",
      "locator": {
        "selector": "nav[aria-label=\"Creator navigation\"] button[aria-label=\"Create post\"][class*=\"themeFloating\"]"
      },
      "expected_text": "Create post",
      "expected_effect": "open_configuration"
    },
    {
      "action": "wait_for",
      "locator": {},
      "conditions": [
        {
          "type": "selector_present",
          "selector": "[role=\"menu\"] [role=\"menuitem\"]"
        }
      ],
      "match": "all",
      "timeout_ms": 30000
    },
    {
      "action": "click",
      "locator": {
        "text": "Post",
        "role": "menuitem",
        "exact": true,
        "som_only": true
      },
      "expected_text": "Post",
      "expected_effect": "open_configuration"
    },
    {
      "action": "wait_for",
      "locator": {},
      "conditions": [
        {
          "type": "selector_present",
          "selector": "textarea[aria-label=\"Title\"]"
        },
        {
          "type": "selector_present",
          "selector": "[aria-label=\"Text input field for post content\"]"
        }
      ],
      "match": "all",
      "timeout_ms": 30000
    },
    {
      "text": "{{post_title}}",
      "action": "fill",
      "locator": {
        "text": "Title",
        "exact": true,
        "som_only": true
      }
    },
    {
      "text": "{{post_body}}",
      "action": "set_text",
      "locator": {
        "text": "Text input field for post content",
        "role": "textbox",
        "exact": true,
        "som_only": true
      },
      "mode": "replace",
      "newline_mode": "preserve"
    },
    {
      "action": "set_checked",
      "locator": {
        "selector": "input[type=\"radio\"][value=\"paid\"]"
      },
      "checked": true
    },
    {
      "action": "set_checked",
      "locator": {
        "selector": "#sell-post-toggle"
      },
      "checked": false
    },
    {
      "action": "assert_element",
      "locator": {
        "selector": "#sell-post-toggle[aria-checked=\"false\"]"
      }
    },
    {
      "action": "click",
      "locator": {
        "text": "Select tiers",
        "exact": true,
        "som_only": true
      }
    },
    {
      "action": "set_checked",
      "locator": {
        "text": "Select all tiers",
        "role": "menuitemcheckbox",
        "exact": true,
        "som_only": true
      },
      "checked": true
    },
    {
      "action": "set_checked",
      "locator": {
        "text": "Select all tiers",
        "role": "menuitemcheckbox",
        "exact": true,
        "som_only": true
      },
      "checked": false
    },
    {
      "action": "set_checked",
      "locator": {
        "role": "menuitemcheckbox",
        "exact": true,
        "som_only": true,
        "text_suffix_pattern": "(?:\\s+[0-9]+\\s+members?)?"
      },
      "checked": true,
      "labels": "{{tier_labels}}"
    },
    {
      "action": "extract",
      "locator": {},
      "items": "body",
      "fields": {
        "sale_off_before_audience": {
          "selector": "#sell-post-toggle",
          "type": "text",
          "attribute": "aria-checked",
          "required": true,
          "pattern": "^false$"
        },
        "sell_post": {
          "selector": "#sell-post-toggle",
          "type": "boolean",
          "attribute": "aria-checked",
          "required": true,
          "pattern": "^false$"
        },
        "sell_this_post": {
          "selector": "#sell-post-toggle",
          "type": "boolean",
          "attribute": "aria-checked",
          "required": true,
          "pattern": "^false$"
        }
      },
      "readability": false,
      "min_items": 1,
      "max_items": 1
    },
    {
      "key": "ESC",
      "action": "key",
      "locator": {}
    },
    {
      "action": "set_checked",
      "locator": {
        "selector": "input[type=\"radio\"][value=\"{{audience}}\"]"
      },
      "checked": true
    },
    {
      "action": "click",
      "locator": {
        "text": "Image",
        "exact": true,
        "som_only": true
      }
    },
    {
      "action": "wait",
      "locator": {},
      "duration_ms": 700
    },
    {
      "action": "upload_file",
      "locator": {
        "text": "Browse",
        "exact": true,
        "som_only": true
      },
      "source_url": "{{image_1_source_url}}",
      "filename": "{{image_1_filename}}",
      "mime_type": "{{image_1_mime_type}}"
    },
    {
      "key": "ESC",
      "action": "key",
      "locator": {}
    },
    {
      "action": "wait_for",
      "locator": {},
      "conditions": [
        {
          "type": "text_present",
          "value": "Saved"
        },
        {
          "type": "selector_present",
          "selector": "img[src*=\"/patreon-media/p/post/\"]"
        }
      ],
      "match": "all",
      "timeout_ms": 30000
    },
    {
      "action": "extract",
      "locator": {},
      "items": "body",
      "fields": {
        "uploaded_first_id": {
          "selector": "img[src*=\"/patreon-media/p/post/\"]",
          "type": "text",
          "attribute": "src",
          "required": true,
          "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
        }
      },
      "readability": false,
      "min_items": 1,
      "max_items": 1
    },
    {
      "action": "upload_file",
      "locator": {
        "text": "Add image",
        "exact": true,
        "som_only": true
      },
      "source_url": "{{image_2_source_url}}",
      "filename": "{{image_2_filename}}",
      "mime_type": "{{image_2_mime_type}}"
    },
    {
      "action": "wait_for",
      "locator": {},
      "conditions": [
        {
          "type": "text_present",
          "value": "Saved"
        },
        {
          "type": "selector_present",
          "selector": "[data-tag=\"image-layout\"] > [class*=\"__imageWrapper\"]:nth-child(2) img"
        }
      ],
      "match": "all",
      "timeout_ms": 30000
    },
    {
      "action": "extract",
      "locator": {},
      "items": "body",
      "fields": {
        "first_after_second_id": {
          "selector": "img[src*=\"/patreon-media/p/post/\"]",
          "type": "text",
          "attribute": "src",
          "required": true,
          "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
        },
        "uploaded_second_id": {
          "selector": "[data-tag=\"image-layout\"] > [class*=\"__imageWrapper\"]:nth-child(2) img",
          "type": "text",
          "attribute": "src",
          "required": true,
          "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
        }
      },
      "readability": false,
      "min_items": 1,
      "max_items": 1
    },
    {
      "action": "assert_values",
      "locator": {},
      "assertions": {
        "first_after_second_id": {
          "equals_field": "uploaded_first_id"
        }
      }
    },
    {
      "key": "CTRL+R",
      "action": "key",
      "locator": {}
    },
    {
      "action": "wait",
      "locator": {},
      "duration_ms": 2500
    },
    {
      "action": "wait_for",
      "locator": {},
      "conditions": [
        {
          "type": "text_present",
          "value": "Saved"
        },
        {
          "type": "selector_present",
          "selector": "[data-tag=\"image-layout\"] > [class*=\"__imageWrapper\"]:nth-child(2) img"
        }
      ],
      "match": "all",
      "timeout_ms": 30000
    },
    {
      "action": "extract",
      "locator": {},
      "items": "body:has(input[value=\"paid\"][aria-checked=\"true\"]) [data-tag=\"image-layout\"] img[class*=\"__blurred\"],body:has(input[value=\"public\"][aria-checked=\"true\"]) [data-tag=\"image-layout\"] img:not([class*=\"__blurred\"])",
      "fields": {
        "attachment_id": {
          "type": "text",
          "attribute": "src",
          "required": true,
          "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
        }
      },
      "readability": false,
      "min_items": 2,
      "max_items": 2
    },
    {
      "action": "extract",
      "locator": {},
      "items": "body",
      "fields": {
        "audience": {
          "selector": "input[type=\"radio\"][value=\"{{audience}}\"][aria-checked=\"true\"]",
          "type": "text",
          "attribute": "value",
          "required": true,
          "pattern": "^\\Q{{audience}}\\E$"
        },
        "gallery_exactly_two": {
          "selector": "[data-tag=\"image-layout\"]:has([class*=\"__imageWrapper\"]:nth-child(2)):not(:has([class*=\"__imageWrapper\"]:nth-child(3)))",
          "type": "text",
          "attribute": "data-tag",
          "required": true,
          "pattern": "^image-layout$"
        },
        "sale_off_evidence": {
          "selector": "#sell-post-toggle[aria-checked=\"false\"],body:not(:has(#sell-post-toggle[aria-checked=\"true\"])) input[value=\"public\"][aria-checked=\"true\"]",
          "type": "text",
          "attribute": "aria-checked",
          "required": true,
          "pattern": "^(false|true)$"
        },
        "saved_body": {
          "selector": "[aria-label=\"Text input field for post content\"] p",
          "type": "text",
          "required": true,
          "pattern": "^\\Q{{post_body}}\\E$",
          "preserve_line_breaks": true,
          "all": true,
          "separator": "\n\n"
        },
        "saved_first_id": {
          "selector": "[data-tag=\"image-layout\"] > [class*=\"__imageWrapper\"]:nth-child(1) img",
          "type": "text",
          "attribute": "src",
          "required": true,
          "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
        },
        "saved_second_id": {
          "selector": "[data-tag=\"image-layout\"] > [class*=\"__imageWrapper\"]:nth-child(2) img",
          "type": "text",
          "attribute": "src",
          "required": true,
          "pattern": "^https://c[0-9]+\\.patreonusercontent\\.com/[^?]*/post/[0-9]+/([0-9a-f]{32})/"
        },
        "saved_title": {
          "selector": "textarea[aria-label=\"Title\"]",
          "type": "text",
          "required": true,
          "pattern": "^\\Q{{post_title}}\\E$"
        }
      },
      "readability": false,
      "min_items": 1,
      "max_items": 1
    },
    {
      "action": "assert_values",
      "locator": {},
      "assertions": {
        "saved_first_id": {
          "equals_field": "uploaded_first_id"
        },
        "saved_second_id": {
          "equals_field": "uploaded_second_id"
        }
      }
    },
    {
      "action": "click",
      "locator": {
        "text": "Select tiers",
        "exact": true,
        "som_only": true
      },
      "optional": true
    },
    {
      "action": "extract",
      "locator": {},
      "items": "body",
      "fields": {
        "audience_with_valid_tiers": {
          "selector": "input[value=\"public\"][aria-checked=\"true\"],body:has([role=\"menuitemcheckbox\"][aria-checked=\"true\"]:not(:contains(\"Select all tiers\"))) input[value=\"paid\"][aria-checked=\"true\"]",
          "type": "text",
          "attribute": "value",
          "required": true,
          "pattern": "^\\Q{{audience}}\\E$"
        },
        "saved_tiers": {
          "selector": "[role=\"menuitemcheckbox\"][aria-checked=\"true\"]:not(:contains(\"Select all tiers\")),input[value=\"public\"][aria-checked=\"true\"]",
          "type": "text",
          "all": true,
          "separator": "\n"
        }
      },
      "readability": false,
      "min_items": 1,
      "max_items": 1
    },
    {
      "action": "assert_values",
      "locator": {},
      "assertions": {
        "saved_tiers": {
          "equals_set": "{{tier_labels}}"
        }
      }
    },
    {
      "key": "ESC",
      "action": "key",
      "locator": {}
    },
    {
      "action": "observe_page",
      "locator": {},
      "items": "body",
      "fields": {
        "audience": {
          "selector": "input[type=\"radio\"][aria-checked=\"true\"]",
          "type": "text",
          "attribute": "value",
          "required": true
        },
        "sale_off_evidence": {
          "selector": "#sell-post-toggle[aria-checked=\"false\"],body:not(:has(#sell-post-toggle[aria-checked=\"true\"])) input[value=\"public\"][aria-checked=\"true\"]",
          "type": "text",
          "attribute": "aria-checked",
          "required": true,
          "pattern": "^(false|true)$"
        },
        "saved_body": {
          "selector": "[aria-label=\"Text input field for post content\"] p",
          "type": "text",
          "required": true,
          "preserve_line_breaks": true,
          "all": true,
          "separator": "\n\n"
        },
        "saved_title": {
          "selector": "textarea[aria-label=\"Title\"]",
          "type": "text",
          "required": true
        }
      },
      "readability": false,
      "min_items": 1,
      "max_items": 1
    },
    {
      "action": "assert_values",
      "locator": {},
      "assertions": {
        "audience": {
          "equals_exact": "{{audience}}",
          "matches": "^(public|paid)$"
        },
        "current_url": {
          "matches": "^https://www\\.patreon\\.com/(?:(?:c|cw)/)?\\Q{{expected_creator_identity}}\\E/posts/(?:[^/?]*-)?[0-9]+/edit(?:\\?.*)?$"
        },
        "saved_body": {
          "equals_exact": "{{post_body}}"
        },
        "saved_title": {
          "equals_exact": "{{post_title}}"
        }
      }
    },
    {
      "action": "click",
      "locator": {
        "text": "Publish",
        "role": "button",
        "exact": true,
        "som_only": true
      },
      "expected_text": "Publish",
      "expected_effect": "immediate_external_commit",
      "confirm_consequence": "immediate_external_commit",
      "once_key": "{{request_id}}"
    },
    {
      "action": "wait_for",
      "locator": {},
      "conditions": [
        {
          "type": "text_present",
          "value": "Your post is live and ready to share!"
        },
        {
          "type": "url_contains",
          "value": "/posts/"
        }
      ],
      "match": "all",
      "timeout_ms": 30000
    },
    {
      "action": "extract",
      "locator": {},
      "items": "body",
      "fields": {
        "published_confirmation": {
          "type": "text",
          "required": true,
          "pattern": "Your post is live and ready to share!"
        }
      },
      "readability": false
    }
  ],
  "output_schema": {}
}