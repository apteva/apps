{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "react": [
        "../../node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "../../node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "ui/DeployPanel.tsx",
    "ui/requestGate.ts"
  ]
}
