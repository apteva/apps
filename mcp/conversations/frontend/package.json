{
  "name": "@apteva/conversations",
  "version": "0.23.18",
  "type": "module",
  "description": "App-owned Conversations client and shared React surfaces",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@apteva/web-sdk": ">=0.7.0 <0.11.0",
    "react": ">=19"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.10"
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:app": "bun run build-app.ts",
    "prepublishOnly": "bun run build && bun run typecheck:consumer",
    "typecheck:consumer": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --moduleResolution bundler --module esnext --jsx react-jsx --target es2022 tests/composer-types.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apteva/apps.git",
    "directory": "mcp/conversations/frontend"
  },
  "publishConfig": {
    "access": "public"
  }
}
